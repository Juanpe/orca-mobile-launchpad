{
  "manifestVersion": 2,
  "id": "launchpad",
  "name": "Launchpad",
  "version": "0.1.0",
  "description": "Build & Run del worktree activo en un simulador o en tu iPhone (cable o Wi-Fi), desde el status bar de Orca.",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "launchpad",
        "title": "Launchpad",
        "icon": "rocket",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      {
        "id": "launchpad.run",
        "title": "Launchpad: Build & Run",
        "when": "workspace"
      },
      {
        "id": "launchpad.stop",
        "title": "Launchpad: Stop",
        "when": "workspace"
      }
    ],
    "keybindings": [
      {
        "command": "launchpad.run",
        "key": "Mod+Alt+R",
        "when": "workspace"
      }
    ],
    "statusBarItems": [
      {
        "id": "run",
        "text": "Launchpad",
        "icon": "rocket",
        "tooltip": "Build & Run del worktree activo",
        "command": "launchpad.run"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "notifications:show"
    },
    {
      "kind": "storage:own"
    }
  ]
}
